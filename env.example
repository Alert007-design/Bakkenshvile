# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Resend (bekræftelses- og billetmail)
RESEND_API_KEY=
EMAIL_FROM=Bakkens Hvile <billetter@send.bakkenshvile.dk>

# --- Fælles personale-login (alle interne sider + interne API-ruter) ----------
# Én adgangskode giver adgang til /bar, /admin, /admin/qr, /admin/fribillet og
# /funktioner. Koden valideres KUN serverside og fremgår aldrig af URL, HTML
# eller klientkode. MÅ ALDRIG eksponeres via NEXT_PUBLIC_*.
#
# STAFF_PASSWORD: den fælles adgangskode (vælg en lang, tilfældig værdi).
# STAFF_SESSION_SECRET: hemmelighed til at signere session-cookien (HMAC). Lang
#   tilfældig streng. Skift den for at tvinge alle personalesessioner til at
#   logge ind igen.
STAFF_PASSWORD=
STAFF_SESSION_SECRET=

# Cron (varselmail to dage før show). Vercel sender automatisk
# "Authorization: Bearer <CRON_SECRET>" med, når denne er sat.
CRON_SECRET=

# Sitets kanoniske basis-URL — ENESTE kilde til absolutte URL'er (QR-koder,
# mail-links, cron). Et domæneskift kræver derfor kun, at denne ændres.
# Sitet ligger indtil videre på https://bakkenshvile.vercel.app (default).
# MÅ IKKE peges på det gamle site (www.bakkenshvile.dk) — så peger QR-koderne
# forkert. Sæt til "https://bakkenshvile.dk", når domænet peger korrekt hertil.
SITE_URL=

# --- Bordbestilling (QR) — under opbygning, ikke i drift endnu ---
# Alle nedenstående er server-only og må ALDRIG eksponeres via NEXT_PUBLIC_*.

# Hemmelighed til QR-tokens (HMAC). Lang tilfældig streng. Kræves for at
# generere QR-ark (npm run qr:sheet) og verificere scanninger.
TABLE_QR_SECRET=
# Tokenversion/sæson. Hæv for at rotere ALLE QR-koder (fx hvis en kode lækkes).
# Default: 2026.
TABLE_TOKEN_VERSION=

# --- Viva.com Smart Checkout (eneste betalingsudbyder for hele sitet) ---------
# VIVA_ENV=live er spærret pr. flow (fail-closed): billet/genbestilling kræver
# TICKETS_LIVE=true, bordbestilling kræver TABLE_ORDERING_LIVE=true. De to flows
# går live uafhængigt af hinanden.
VIVA_ENV=demo
# Billet/genbestillings live-flag. Default false. Skal være true, før
# VIVA_ENV=live tillader livebetaling af billetter (uafhængigt af bord-flaget).
TICKETS_LIVE=false
# OAuth2 client credentials (Viva → Settings → API access).
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Merchant-id + API-nøgle (Viva → Settings → API access) — bruges KUN til at
# hente webhook-verifikationsnøglen (Basic auth, ikke OAuth2-tokenet).
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Delt hemmelighed i webhook-URL'ens ?k= (adgangskontrol på Viva-webhooken).
# Viva signerer ikke sine webhooks; derfor beskyttes endpointet med denne
# hemmelighed, og transaktionen hentes ALTID hos Viva før nogen handling.
VIVA_WEBHOOK_TOKEN=

# Payment sources (success/failure-URL sidder på sourcen, ikke på betalingen).
#   TABLE   → success /bord/kvittering,  failure /bord/afbrudt
#   TICKETS → success /success,          failure /afbrudt
# VIVA_SOURCE_CODE beholdes som fallback, så bordbestillingen ikke knækker.
VIVA_SOURCE_CODE_TABLE=
VIVA_SOURCE_CODE_TICKETS=
VIVA_SOURCE_CODE=

# Sikkerhedskontakter. Default false. Ingen livebetaling før begge er true
# OG lovpligtig salgsregistrering er konfigureret.
TABLE_ORDERING_ENABLED=false
TABLE_ORDERING_LIVE=false

# Transaktionsdatabase (Vercel Postgres). Sættes automatisk af Vercel Postgres-
# integrationen ved tilkobling:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
