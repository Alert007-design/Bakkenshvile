# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Stripe — UDFASET. Hele sitet betaler nu via Viva (se nedenfor). Nøglerne
# beholdes kun, hvis man vil aktivere Stripe-koden (død kode) igen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (bekræftelsesmail)
RESEND_API_KEY=
EMAIL_FROM=Bakkens Hvile <billetter@send.bakkenshvile.dk>

# Admin-side beskyttelse
ADMIN_KEY=

# Cron (varselmail to dage før show). Vercel sender automatisk
# "Authorization: Bearer <CRON_SECRET>" med, når denne er sat.
CRON_SECRET=

# Sitets kanoniske basis-URL — ENESTE kilde til absolutte URL'er (QR-koder,
# mail-links, cron). Et domæneskift kræver derfor kun, at denne ændres.
# Sitet ligger indtil videre på https://bakkenshvile.vercel.app (default).
# MÅ IKKE peges på det gamle site (www.bakkenshvile.dk) — så peger QR-koderne
# forkert. Sæt til "https://bakkenshvile.dk", når domænet peger korrekt hertil.
SITE_URL=

# --- Bordbestilling (QR) — under opbygning, ikke i drift endnu ---
# Alle nedenstående er server-only og må ALDRIG eksponeres via NEXT_PUBLIC_*.

# Hemmelighed til QR-tokens (HMAC). Lang tilfældig streng. Kræves for at
# generere QR-ark (npm run qr:sheet) og verificere scanninger.
TABLE_QR_SECRET=
# Tokenversion/sæson. Hæv for at rotere alle QR-koder. Default: 2026.
TABLE_TOKEN_VERSION=

# Barens arbejdsskærm (/bar): login-kode og cookie-signeringshemmelighed.
BAR_SCREEN_PASSWORD=
BAR_SESSION_SECRET=

# Særskilt Stripe-webhook-secret til bordbestilling (UDFASET — se Stripe ovenfor).
STRIPE_TABLE_WEBHOOK_SECRET=

# Valg af betalingsudbyder: "stripe" | "viva". Hele sitet (billet, genbestil,
# bordbestilling) betaler via denne. Sæt til "viva".
PAYMENT_PROVIDER=viva

# --- Viva.com Smart Checkout (hele sitet) ---
# VIVA_ENV=live er spærret, indtil TABLE_ORDERING_LIVE=true (fail-closed).
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Delt hemmelighed i webhook-URL'ens ?k= (adgangskontrol på Viva-webhooken).
VIVA_WEBHOOK_TOKEN=

# Payment sources (success/failure-URL sidder på sourcen, ikke på betalingen).
#   TABLE   → success /bord/kvittering,  failure /bord/afbrudt
#   TICKETS → success /success,          failure /afbrudt
# VIVA_SOURCE_CODE beholdes som fallback, så bordbestillingen ikke knækker.
VIVA_SOURCE_CODE_TABLE=8222
VIVA_SOURCE_CODE_TICKETS=
VIVA_SOURCE_CODE=8222

# Sikkerhedskontakter. Default false. Ingen livebetaling før begge er true
# OG lovpligtig salgsregistrering er konfigureret.
TABLE_ORDERING_ENABLED=false
TABLE_ORDERING_LIVE=false

# Transaktionsdatabase (Vercel Postgres). Sættes automatisk af Vercel Postgres-
# integrationen ved tilkobling:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
